# --- Mercado Livre (app criado em https://developers.mercadolivre.com.br/devcenter) ---
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Site do ML (MLB = Brasil)
ML_SITE_ID=MLB

# --- Afiliados (portal de afiliados > gerador de links: copie os valores de matt_tool e matt_word) ---
ML_AFFILIATE_TOOL=
ML_AFFILIATE_WORD=

# Listas públicas de recomendação (link de compartilhar), separadas por vírgula
ML_LIST_URLS=
# Categorias dos mais vendidos usados quando a lista acabar (IDs em https://api.mercadolibre.com/sites/MLB/categories)
# Padrão: Informática, Games, Brinquedos e Hobbies, Eletrônicos, Celulares
ML_CATEGORIES=MLB1648,MLB1144,MLB1132,MLB1000,MLB1051

# --- Telegram ---
# Token do @BotFather
TELEGRAM_BOT_TOKEN=
# @nome_do_canal (canal público) ou -100xxxxxxxxxx (canal privado)
TELEGRAM_CHANNEL_ID=@seu_canal
# Seu ID numérico (mande /start ao bot para descobrir). Libera /postar e /status. Vários: separe por vírgula
TELEGRAM_ADMIN_IDS=

# --- Postagem ---
POST_INTERVAL_MINUTES=120
# Repostar produto da lista após N dias se o preço caiu pelo menos X%
REPOST_AFTER_DAYS=3
REPOST_MIN_DROP_PERCENT=5
